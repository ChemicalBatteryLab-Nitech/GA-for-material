SYSTEM = GmAte ionic relaxation

# Electronic minimization
ISTART = 0        ! start from scratch
ICHARG = 2        ! superposition of atomic charge densities
ENCUT  = 400      ! plane-wave cutoff (eV); adjust to your POTCAR
EDIFF  = 1E-5     ! electronic convergence criterion (eV)
PREC   = Normal

# Smearing
ISMEAR = 0        ! Gaussian smearing (good for insulators/semiconductors)
SIGMA  = 0.05     ! smearing width (eV)

# Ionic relaxation
NSW    = 200       ! max ionic steps
IBRION = 2        ! conjugate gradient algorithm
ISIF   = 2        ! relax ionic positions only (keep cell shape fixed)
EDIFFG = -0.05    ! force convergence criterion (eV/Å, negative = force-based)
POTIM  = 0.3      ! step size for ionic moves

# Output control (keep small files for GA runs)
LWAVE  = .FALSE.  ! do not write WAVECAR
LCHARG = .FALSE.  ! do not write CHGCAR
NWRITE = 0        ! minimal stdout
